{
  "name": "strapi-plugin-review-flow",
  "version": "5.0.0-alpha.7",
  "description": "Free & simple editorial review workflow plugin for Strapi 5. Add an approval gate to your content to ensure quality and consistency or secure your content from unauthorized publication.",
  "keywords": [
    "approval",
    "consistency",
    "editorial",
    "flow",
    "plugin",
    "publication",
    "quality",
    "review",
    "strapi",
    "strapi-plugin",
    "strapi-plugin-review-flow",
    "workflow"
  ],
  "homepage": "https://github.com/breezertwo/strapi-plugin-review-flow#readme",
  "bugs": {
    "url": "https://github.com/breezertwo/strapi-plugin-review-flow/issues"
  },
  "license": "MIT",
  "author": "breezertwo <andreas@heycare.com>",
  "repository": {
    "type": "git",
    "url": "git://github.com/breezertwo/strapi-plugin-review-flow"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit",
    "release": "release-it",
    "release:alpha": "release-it --preid=alpha"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.0",
    "@strapi/design-system": "2.2.3",
    "@strapi/icons": "2.2.3",
    "@strapi/sdk-plugin": "6.1.1",
    "@strapi/strapi": "^5.51.0",
    "@strapi/typescript-utils": "^5.51.0",
    "@types/koa": "^3.0.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "6.6.2",
    "react-router-dom": "^6.30.3",
    "release-it": "^21.0.0",
    "styled-components": "^6.3.8",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.0",
    "@strapi/icons": "^2.2.0",
    "@strapi/strapi": "^5",
    "react": "^18",
    "react-dom": "^18",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6",
    "styled-components": "^6"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "strapi": {
    "kind": "plugin",
    "name": "review-workflow",
    "displayName": "Review Flow",
    "description": "Free & simple editorial review workflow plugin for Strapi 5. Add an approval gate to your content to ensure quality and consistency or secure your content from unauthorized publication."
  }
}
